#! /usr/bin/env bash
set -e

# Remove only the 2D/3D data now supplied by sage-data-polytopes.  Keep the
# independently packaged 4D Hodge database in this parent directory.
: "${SAGE_SHARE:?SAGE_SHARE must be set}"
rm -rf "${SAGE_SHARE}/reflexive_polytopes/Full2d"
rm -rf "${SAGE_SHARE}/reflexive_polytopes/Full3d"
rm -f "${SAGE_SHARE}/reflexive_polytopes/reflexive_polytopes_2d"
rm -f "${SAGE_SHARE}/reflexive_polytopes/reflexive_polytopes_3d"
